{
  "name": "dsh-rws-tarot",
  "version": "0.4.0",
  "description": "Rider-Waite-Smith tarot for DeepSeek Harness: lay the book's three methods, or a plain draw, three cards or nine in the right dock, then turn the cards and have them read from Waite's Pictorial Key.",
  "icon": "./icon.svg",
  "author": {
    "name": "Firefox2100",
    "url": "https://github.com/Firefox2100"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./assets/*": "./lib/assets/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firefox2100/dsh-rws-tarot.git",
    "directory": "packages/tarot"
  },
  "homepage": "https://github.com/Firefox2100/dsh-rws-tarot#readme",
  "bugs": {
    "url": "https://github.com/Firefox2100/dsh-rws-tarot/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "tarot",
    "rider-waite-smith",
    "divination"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "files": [
    "icon.svg",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-include": "^1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@dsh-rws-tarot/data": "workspace:*",
    "@dsh-rws-tarot/engine": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
